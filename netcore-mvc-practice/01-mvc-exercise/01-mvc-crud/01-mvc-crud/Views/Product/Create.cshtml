@model _01_mvc_crud.Models.Product

@{
    ViewData["Title"] = "CREAR PRODUCTO";
}

<h4>@ViewData["Title"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            @* resumen de errores de validacion del modelo *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* nombre del producto *@
            <div class="form-group">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            @* proveedor (dropdown) *@
            <div class="form-group">
                <label asp-for="SupplierID" class="control-label"></label>
                <select asp-for="SupplierID" asp-items="ViewBag.Suppliers" class="form-select">
                    <option value="" disabled selected>-- Seleccione un Proveedor --</option>
                </select>
                <span asp-validation-for="SupplierID" class="text-danger"></span>
            </div>

            @* categoria (dropdown) *@
            <div class="form-group">
                <label asp-for="CategoryID" class="control-label"></label>
                <select asp-for="CategoryID" asp-items="ViewBag.Categories" class="form-select">
                    <option value="" disabled selected>-- Seleccione una Categoria --</option>
                </select>
                <span asp-validation-for="CategoryID" class="text-danger"></span>
            </div>

            @* precio *@
            <div class="form-group">
                <label asp-for="UnitPrice" class="control-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            @* stock *@
            <div class="form-group">
                <label asp-for="UnitsInStock" class="control-label"></label>
                <input asp-for="UnitsInStock" class="form-control" />
                <span asp-validation-for="UnitsInStock" class="text-danger"></span>
            </div>
           
            @* botones *@
            <div class="form-group">
                <input type="submit" value="Guardar Producto" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="ListProductName" class="btn btn-secondary">Cancelar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
